{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Validation error body: {\"errors\": {\"<field>\": [\"<message>\", ...]}}",
  "type": "object",
  "additionalProperties": false,
  "required": ["errors"],
  "properties": {
    "errors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    }
  }
}
