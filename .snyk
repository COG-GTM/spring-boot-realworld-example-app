# Snyk (https://snyk.io) policy file
version: v1.25.0
ignore:
  SNYK-JAVA-ORGSPRINGFRAMEWORK-19267094:
    - '*':
        reason: >-
          CVE-2026-47890 (GHSA-j9f9-w8pj-32f8) in org.springframework:spring-webmvc 6.2.19,
          managed by Spring Boot 3.5.16. Time-boxed ignore approved by Joel O'Shea on 2026-11-17.
          The app is not exposed: it has no Server-Sent Events, view fragments or view rendering
          (no SseEmitter, ServerSentEvent, FragmentsRendering, XsltView or ViewResolver in src).
          No 6.2.x fix exists; the fix needs Spring Framework 7.0.9 (Spring Boot 4).
        expires: 2027-02-15T00:00:00.000Z
        created: 2026-11-17T00:00:00.000Z
  SNYK-JAVA-ORGSPRINGFRAMEWORKGRAPHQL-19267447:
    - '*':
        reason: >-
          CVE-2026-59286 in org.springframework.graphql:spring-graphql 1.4.6 (GraphiQL loaded from a CDN). Time-boxed ignore approved by Joel O'Shea on 2026-11-17.
          No fix on Boot 3.x; the fix needs Spring for GraphQL 2.0.5 (Spring Boot 4).
          Exposure: YES, revisit. GraphiQL is enabled and public at /graphiql and loads its scripts from esm.sh.
        expires: 2027-02-15T00:00:00.000Z
        created: 2026-11-17T00:00:00.000Z
